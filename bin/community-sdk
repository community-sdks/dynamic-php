#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__).'/vendor/autoload.php';

use CommunitySDKs\Developer\IdeStubGenerator;
use CommunitySDKs\Developer\DtoGenerator;
use CommunitySDKs\OpenApi\{Document, Registry};

// Commands read a local specification; no code is executed from the spec.
[$script, $command, $file] = array_pad($argv, 3, null);
if (!$command || !$file || !in_array($command, ['list', 'describe', 'docs', 'ide', 'dto'], true)) {
    fwrite(STDERR, "Usage: community-sdk <list|describe|docs|ide|dto> <openapi.json|yaml> [operationId|namespace]\n");
    exit(2);
}
try {
    $doc = Document::fromFile($file);
    $registry = new Registry($doc);
    if ($command === 'list') {
        foreach ($registry->all(search: $argv[3] ?? null) as $id => $op) {
            echo sprintf("%-35s %7s %s\n", $id, $op['_method'], $op['_path']);
        }
    } elseif ($command === 'describe') {
        $id = $argv[3] ?? throw new RuntimeException('Specify operationId.');
        echo json_encode($registry->get($id), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n";
    } elseif ($command === 'docs') {
        echo "# ".($doc->data['info']['title'] ?? 'API')."\n\n";
        foreach ($registry->all() as $id => $op) {
            echo "## {$id}\n\n{$op['_method']} `{$op['_path']}`\n\n";
            if (isset($op['summary'])) echo $op['summary']."\n\n";
            foreach ($op['_parameters'] as $p) {
                echo "- `{$p['name']}` ({$p['in']}, ".(($p['required'] ?? false) ? 'required' : 'optional').")\n";
            }
            if (isset($op['requestBody'])) echo "- `body` (requestBody)\n";
            echo "\nResponses: ".implode(', ', array_keys($op['responses'] ?? []))."\n\n";
        }
    } elseif ($command === 'ide') {
        echo (new IdeStubGenerator($doc))->generate();
    } elseif ($command === 'dto') {
        echo (new DtoGenerator($doc))->generate($argv[3] ?? 'CommunitySDKs\\Generated');
    }
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage()."\n");
    exit(1);
}
