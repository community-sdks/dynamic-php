{
  "name": "community-sdks/dynamic-php",
  "description": "OpenAPI-driven dynamic PHP API client with validation and developer tooling.",
  "type": "library",
  "license": "MIT",
  "keywords": ["openapi", "dynamic-sdk", "api", "client"],
  "require": {"php": "^8.4", "ext-json": "*", "symfony/yaml": "^7.2 || ^8.0",
    "opis/json-schema": "^2.4"},
  "require-dev": {"phpunit/phpunit": "^11.5 || ^12.0", "phpstan/phpstan": "^2.1"},
  "autoload": {"psr-4": {"CommunitySDKs\\": "src/"}},
  "autoload-dev": {"psr-4": {"CommunitySDKs\\Tests\\": "tests/"}},
  "bin": ["bin/community-sdk"],
  "scripts": {"test": "phpunit", "analyse": "phpstan analyse --no-progress", "check": ["@test", "@analyse"]},
  "minimum-stability": "stable", "prefer-stable": true
}
